{
  "name": "@filedrop/api",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "lint": "eslint src/",
    "typecheck": "tsc --noEmit",
    "migrate": "knex --knexfile src/knexfile.ts migrate:latest",
    "migrate:rollback": "knex --knexfile src/knexfile.ts migrate:rollback"
  },
  "dependencies": {
    "@filedrop/shared": "*",
    "bcrypt": "^6.0.0",
    "bonjour-service": "^1.4.4",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^8.7.0",
    "helmet": "^7.2.0",
    "jszip": "^3.10.1",
    "knex": "^3.1.0",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.2",
    "node-cron": "^3.0.3",
    "pg": "^8.12.0",
    "qrcode": "^1.5.3",
    "socket.io": "^4.8.3",
    "uuid": "^11.0.0"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/morgan": "^1.9.9",
    "@types/multer": "^1.4.13",
    "@types/node": "^20.14.12",
    "@types/node-cron": "^3.0.11",
    "@types/qrcode": "^1.5.5",
    "eslint": "^9.9.0",
    "node-forge": "^1.4.0",
    "selfsigned": "^5.5.0",
    "tsx": "^4.16.2",
    "typescript": "^5.5.4"
  }
}
